# MySQL (Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=portfoliopass
MYSQL_PORT=3011

APP_PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3011
DB_NAME=portfolio
DB_USER=root
DB_PASSWORD=rootpassword

# --- Регистрация ---
# 1 = код на экране для всех; письмо — только на REGISTER_DEVELOPER_EMAIL
REGISTER_DEMO_MODE=1
REGISTER_SHOW_CODE=1
REGISTER_DEVELOPER_EMAIL=your-email@gmail.com

# gas | brevo | smtp — для письма разработчику в демо-режиме
MAIL_PROVIDER=gas
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-email@gmail.com
BREVO_SENDER_NAME=Portfolio

# Резерв: Google Apps Script
GOOGLE_SCRIPT_MAIL_URL=
GOOGLE_SCRIPT_MAIL_SECRET=

SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM="Portfolio <your-email@gmail.com>"

# Инструкция по Brevo: scripts/BREVO-SETUP.md
